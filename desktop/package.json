{
  "name": "silent-garden-motion-studio",
  "productName": "Silent Garden Motion Studio",
  "version": "1.1.0",
  "description": "Silent Garden Motion Studio v1.1 — reference-based professional editor with customizable Studio Themes",
  "author": "Silent Garden Team",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "prepare:assets": "node prepare-assets.cjs",
    "start": "npm run prepare:assets && electron .",
    "dist:win": "npm run prepare:assets && electron-builder --win portable --x64 --publish never",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer/startup.js && node --check renderer/app.js && node --check renderer/theme.js",
    "smoke:win": "npm run prepare:assets && electron . --sg-smoke-test"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.silentgarden.motionstudio",
    "productName": "Silent Garden Motion Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "blender/export_to_fbx.py",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "SilentGardenMotionStudio-Portable-${version}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "extraMetadata": {
      "homepage": "https://github.com/BloodPetalsdev/blood_petals_site"
    }
  }
}
